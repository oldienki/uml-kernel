# UML guest kernel config fragment for the UML test backend.
# Applied on top of `make ARCH=um defconfig` via merge_config.sh.
# Pin: linux-6.6.58 (see Dockerfile KERNEL_VERSION / KERNEL_SHA256).

# --- Core UML devices -------------------------------------------------------
# NOTE: the UML block driver is BLK_DEV_UBD in 6.x (not CONFIG_UBD);
# ARCH=um implies the UML platform itself (no CONFIG_UML symbol).
CONFIG_BLK_DEV_UBD=y
CONFIG_HOSTFS=y
CONFIG_UML_NET=y
CONFIG_UML_NET_TUNTAP=y
CONFIG_UML_NET_DAEMON=n
CONFIG_UML_NET_MCAST=n

# --- Block / fs --------------------------------------------------------------
CONFIG_BLK_DEV_INITRD=n
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- Networking core ---------------------------------------------------------
CONFIG_NET=y
CONFIG_INET=y
# IPV6 required: NF_TABLES_INET (inet nft tables used by
# /etc/nftables.conf and k4dpi) depends on IPV6 in 6.6 — the um
# defconfig leaves it off.
CONFIG_IPV6=y
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_IGMP_SNOOPING=y
CONFIG_VLAN_8021Q=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_ROUTE_MULTIPATH=y
CONFIG_SYN_COOKIES=y

# --- Netfilter / nftables ----------------------------------------------------
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
# ct mark expressions in init/k4dpi.nft require conntrack mark support.
CONFIG_NF_CONNTRACK_MARK=y
# /proc/net/nf_conntrack — used by the router-validation suite to prove
# LAN flows are masqueraded inside the guest kernel.
CONFIG_NF_CONNTRACK_PROCFS=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_PAYLOAD=y
CONFIG_NFT_META=y
CONFIG_NFT_HASH=y
CONFIG_NFT_SOCKET=y
CONFIG_NFT_TPROXY=n
CONFIG_NFT_COMPAT=y
# reject verdicts used by k4dpi-generated static rules.
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_ARP=n
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_TARGET_MASQUERADE=y

# --- Traffic control (tc) -----------------------------------------------------
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_SCH_SFQ=y
CONFIG_NET_CLS=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_CLS_FW=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_ACT_GACT=y
CONFIG_NET_ACT_MIRRED=y
CONFIG_NET_ACT_SKBEDIT=y
CONFIG_NET_ACT_CSUM=n
CONFIG_NET_EMATCH=n
CONFIG_CLS_U32_MARK=y

# --- eBPF capability (future hooks; not used by tests yet) ---------------------
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=n
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_XDP_SOCKETS=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_BPF_EVENTS=n

# --- Misc required by OpenWrt userland ----------------------------------------
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET_DIAG=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=n
CONFIG_KALLSYMS=y
CONFIG_PROC_KCORE=n
CONFIG_RANDOM_TRUST_CPU=y
CONFIG_VT=n
CONFIG_LEGACY_PTYS=n
CONFIG_UNIX98_PTYS=y
